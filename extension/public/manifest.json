{
  "manifest_version": 3,
  "name": "Paranoia Wallet",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Independent smart wallet for Celo Sepolia, Ethereum Sepolia, BNB Testnet and Polygon Amoy with on-chain policies.",
  "action": {
    "default_title": "Paranoia Wallet",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "ISOLATED" },
    { "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["provider.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://forno.celo-sepolia.celo-testnet.org/*",
    "https://public.pimlico.io/*",
    "https://ethereum-sepolia-rpc.publicnode.com/*",
    "https://bsc-testnet-dataseed.bnbchain.org/*",
    "https://polygon-amoy-bor-rpc.publicnode.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
